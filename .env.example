# ---------------------------------------------------------------------------
# MarketPulse — variáveis de ambiente
# Copie para `.env` (`cp .env.example .env`) e ajuste conforme necessário.
# O arquivo `.env` é lido pelo Docker Compose e pelo backend (Pydantic Settings).
# ---------------------------------------------------------------------------

# -- Aplicação --------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# -- Banco de dados ---------------------------------------------------------
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=marketpulse
POSTGRES_DB=marketpulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -- Portas expostas pelo Docker Compose ------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# -- CORS (lista separada por vírgulas) -------------------------------------
CORS_ORIGINS=http://localhost:5173

# -- Autenticação -------------------------------------------------------------
# ATENÇÃO: gere uma chave própria para produção (ex.: `openssl rand -hex 32`).
# O backend recusa subir com este valor de exemplo quando ENVIRONMENT=production.
SECRET_KEY=insecure-dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -- Frontend ---------------------------------------------------------------
VITE_API_URL=http://localhost:8000
